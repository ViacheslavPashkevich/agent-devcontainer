# Copy to .devcontainer/.env (gitignored). Compose reads it when the container
# is created, so after a change: recreate, from the host —
#   devcontainer up --workspace-folder <checkout> --remove-existing-container
#
# Everything here is optional: a fresh clone boots without the file, and
# `devc doctor` reports what is missing.

# Seeds the git identity in the container home on first create. Set-if-absent:
# an identity already configured inside is never overwritten. Leave blank to
# set it by hand inside (git config --global user.name ...).
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- project section --------------------------------------------------------
# Tokens and settings the project's own tooling reads from the environment.
# --- end of project section -------------------------------------------------
