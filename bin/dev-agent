#!/bin/sh
#
# The single documented way into the development environment: start the
# devcontainer if it is not running, then attach the herdr TUI inside it.
# Identical locally and over SSH. See docs/development/setup.md.
#
# POSIX sh rather than the ruby shebang the rest of bin/ uses: this is the one
# script that runs on the bare host, where only Docker, git and the devcontainer
# CLI are promised.

set -u

usage() {
	printf '%s\n' \
		'Usage: bin/dev-agent [--update | --rebuild | --stop]' \
		'' \
		'  (no flags)  Start the devcontainer if it is not running, then attach' \
		'              the herdr TUI inside it. Running it again reattaches.' \
		'  --update    Rebuild the image tool layers against a fresh TOOLS_EPOCH,' \
		'              recreate the container, then attach.' \
		'  --rebuild   As --update, but building from scratch: base image and' \
		'              runtime layers included.' \
		'  --stop      Stop the app and postgres containers to free host' \
		'              resources. Removes nothing; the next run restarts them.' \
		'' \
		'All modes keep the named volumes, so the container home and its logins' \
		'survive.'
}

die() {
	printf 'bin/dev-agent: %s\n' "$1" >&2
	exit 1
}

mode=attach
while [ "$#" -gt 0 ]; do
	case "$1" in
	--update | --rebuild | --stop)
		# Mutually exclusive: --rebuild is a superset of --update, and --stop
		# is the opposite of both, so a run asking for two is asking for
		# something undefined.
		[ "$mode" = attach ] || {
			printf 'bin/dev-agent: --update, --rebuild and --stop are mutually exclusive\n' >&2
			usage >&2
			exit 2
		}
		mode=${1#--}
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf 'bin/dev-agent: unknown argument: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

# The workspace root is the primary checkout, resolved from this script's own
# location: a copy running out of .worktrees/<branch>/bin must attach to the one
# container started for the primary path rather than start a second one.
# `git rev-parse --git-common-dir` prints a path relative to its own working
# directory in the primary checkout (`--path-format=absolute` needs git >= 2.31,
# which a remote host cannot be assumed to have), so resolve it there.
script_dir=$(cd "$(dirname "$0")" && pwd -P) ||
	die 'cannot resolve my own location'
git_common=$(git -C "$script_dir" rev-parse --git-common-dir 2>/dev/null) &&
	git_common=$(cd "$script_dir" && cd "$git_common" 2>/dev/null && pwd -P)
if [ -n "${git_common:-}" ]; then
	root=${git_common%/*}
else
	# Not a git checkout at all (a tarball copy); the script still sits in bin/.
	root=$(cd "$script_dir/.." && pwd -P) ||
		die 'cannot resolve the workspace root'
fi

# All read-only, so they re-run on every invocation — including the warm attach,
# which still touches no container state. Ordered by dependency: each check's
# diagnostic is only meaningful once the previous one passed.
command -v docker >/dev/null 2>&1 ||
	die 'Docker is not installed — install Docker Desktop (macOS) or docker-ce (Linux)'
# Only stdout is swallowed: a failing `docker info` also means socket
# permissions, a stale DOCKER_HOST or a bad context, and docker's own
# diagnostic is the part that says which.
docker info >/dev/null ||
	die 'cannot connect to the Docker daemon — make sure Docker is running and your user can reach it'
# The rest is gated by mode: the stop path is pure docker, so a missing
# devcontainer CLI or a Compose plugin too old to start the environment must
# never stand between the operator and freeing the host's resources.
if [ "$mode" != stop ]; then
	command -v devcontainer >/dev/null 2>&1 ||
		die 'devcontainer CLI missing — npm install -g @devcontainers/cli'

	# `env_file: required: false` in .devcontainer/compose.yaml needs Compose
	# >= 2.24; below that the file fails validation inside `devcontainer up`,
	# which names neither the version nor the file.
	compose_version=$(docker compose version --short 2>/dev/null) ||
		die 'the Docker Compose plugin is missing — install Docker Compose >= 2.24 (Docker Desktop bundles it)'
	compose_number=${compose_version#v}
	compose_major=${compose_number%%.*}
	compose_minor=${compose_number#*.}
	compose_minor=${compose_minor%%[!0-9]*}
	case "$compose_major:$compose_minor" in
	'':* | *:'' | *[!0-9]*:* | *:*[!0-9]*)
		# Versioning varies across distributions and Docker Desktop's own
		# scheme (major 5 observed in the wild). An unrecognised shape warns
		# rather than refuses a healthy host: `devcontainer up` still fails
		# loudly if compose really is too old.
		printf 'bin/dev-agent: cannot read the Docker Compose version (%s); continuing\n' \
			"$compose_version" >&2
		;;
	*)
		if [ "$compose_major" -lt 2 ] ||
			{ [ "$compose_major" -eq 2 ] && [ "$compose_minor" -lt 24 ]; }; then
			die "Docker Compose >= 2.24 required (found $compose_version) — update Docker"
		fi
		;;
	esac
fi

case "$mode" in
update | rebuild)
	# No warm probe: the point of both flags is to recreate the container. That
	# takes it out from under any other attached session, which is inherent to
	# --remove-existing-container and true of the raw command these wrap.
	TOOLS_EPOCH=$(date +%s) || die 'cannot read the clock for TOOLS_EPOCH'
	export TOOLS_EPOCH
	set -- devcontainer up --workspace-folder "$root" --remove-existing-container
	[ "$mode" = rebuild ] && set -- "$@" --build-no-cache
	"$@" || exit $?
	;;
stop)
	# Any state (-a): a stopped app container must still be found, because its
	# labels are what name the environment. The compose project label on that
	# container is the only authority — the project name is never recomputed
	# from the checkout directory (worktree-unsafe; see the attach probe below).
	app=$(docker ps -aq --filter "label=devcontainer.local_folder=$root") ||
		die 'docker ps failed — refusing to guess the environment state'
	if [ -z "$app" ]; then
		printf 'bin/dev-agent: nothing to stop — no devcontainer exists for %s\n' "$root"
		exit 0
	fi
	# Word-splitting on purpose: keep the first id should stale duplicates
	# exist (--remove-existing-container normally prevents that).
	# shellcheck disable=SC2086
	set -- $app
	app=$1
	project=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$app") ||
		die 'docker inspect failed — cannot read the compose project label'
	case "$project" in
	'' | '<no value>')
		# Go templates render an absent map key as either, depending on the
		# path taken; both mean the label is not there. A hard error rather
		# than a false "nothing running" while postgres keeps burning memory.
		die "container $app carries no compose project label"
		;;
	esac
	running=$(docker ps -q --filter "label=com.docker.compose.project=$project") ||
		die 'docker ps failed — refusing to guess what is running'
	if [ -z "$running" ]; then
		printf 'bin/dev-agent: already stopped — no %s container is running\n' "$project"
		exit 0
	fi
	# One id per line; splitting them into arguments is the intent. docker's
	# own output is the confirmation, and its status propagates untouched.
	# shellcheck disable=SC2086
	docker stop $running || exit $?
	exit 0
	;;
attach)
	# The devcontainer CLI labels the container with the literal workspace path
	# it was given, which is the identity to probe. The compose project name is
	# CLI-derived from the checkout directory and differs per worktree, so
	# anything built on it reports "nothing running" against a healthy
	# environment. `docker ps` without -a already means running only, so a
	# stopped container takes the cold path and `up` restarts it.
	running=$(docker ps -q --filter "label=devcontainer.local_folder=$root") ||
		die 'docker ps failed — refusing to guess whether the container is running'
	if [ -z "$running" ]; then
		# Streamed, not captured: a cold start is slow and the operator should
		# see what it is doing.
		devcontainer up --workspace-folder "$root" || exit $?
	fi
	;;
esac

# exec, so herdr's exit status (0 on a `ctrl+b q` detach) is this script's and
# no wrapper process outlives the session. The CLI finds the container by the
# same label and honours remoteUser and workspaceFolder.
exec devcontainer exec --workspace-folder "$root" herdr
